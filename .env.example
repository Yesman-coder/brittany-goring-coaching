# ─── Booking calendar — Cal.com (open-source, recommended) ─────
# 1. Sign up at https://cal.com with any email you have access to
# 2. Create an event type: "Free Consultation" (30 min)
# 3. Event Settings → Notifications → set organizer email to brittanygoring@gmail.com
# 4. Copy your booking path (just username/event-slug, no https://)
# Example: brittany-goring/free-consultation
NEXT_PUBLIC_CAL_LINK=

# ─── Booking calendar — Calendly (alternative) ──────────────────
# Example: https://calendly.com/brittany-goring/free-consultation
NEXT_PUBLIC_CALENDLY_URL=

# ─── Contact form (Formspree) ──────────────────────────────────
# Create a free form at https://formspree.io and paste the endpoint here.
# Example: https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
